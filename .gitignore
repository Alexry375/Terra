# Fichiers volumineux ou reconstructibles : jamais versionnes.

# Images sources (droits d'auteur + poids)
data/scans/
data/regles/photos-originales/

# Artefacts de compilation Rust (reconstructibles par `cargo build`)
engine/target/
target/

# Traces de session de l'outil de navigation
.playwright-mcp/

# Divers systeme
*.pyc
__pycache__/
.DS_Store

# Note : le dossier workspaces/ (ateliers des sous-agents) est exclu par
# .git/info/exclude, pose par l'outil `aw`. Les livrables y sont promus
# manuellement dans engine/ ou data/ apres audit.
.claude/worktrees/

# Flux d'erreur vides des campagnes de mesure (aucun contenu)
data/mesures/**/*.err

# Instantanes de l'entrainement "A 2M", arrete a 760 000 parties : ils portent
# l'ancienne fiche de situation a 1472 cases. Depuis le lot L3 la fiche en
# compte 1630, et `Reseau::lire` refuse tout fichier dont la table de noms
# differe : ces poids ne sont plus lisibles par le moteur. Conserves sur le
# disque, hors du depot. La trace de l'entrainement, elle, est versionnee
# (data/mesures/entrainement-A-2M-suite.log).
data/poids/apprenti-2M.txt.*
data/poids/apprenti-1200k.txt

# ─────────────────────────────────────────────────────────────────────────────
# RESSOURCES SOUS DROITS D'AUTEUR — JAMAIS VERSIONNEES, JAMAIS PUBLIEES.
#
# Ce depot est public. Il ne distribue aucun visuel du jeu, aucune photo du
# livret de regles, aucune page numerisee. Ces fichiers vivent sur la machine de
# celui qui possede le jeu, et nulle part ailleurs. Voir README.md.
#
# Pour remplir ces dossiers : numerisez vos propres cartes et suivez les noms de
# fichiers donnes par `web/webapp/assets/manifeste.json`.
web/webapp/assets/cartes/*
!web/webapp/assets/cartes/LISEZ-MOI.md
web/webapp/assets/plateau/*
!web/webapp/assets/plateau/sol-martien-granicus-valles-nasa.jpg
!web/webapp/assets/plateau/CREDITS-sol-martien.md
!web/webapp/assets/plateau/LISEZ-MOI.md
web/webapp/assets/menu/*
!web/webapp/assets/menu/LISEZ-MOI.md
docs/regles/photos/
docs/regles/transcription-brute/
docs/regles/livret-base.md
docs/regles/livret-decouverte.md
data/cartes-imprimees/
web/demo-decor/

# Sorties des bancs d'ecran (`web/webapp/verif/*.py`) : ce sont des CAPTURES DE
# LA PAGE EN TRAIN DE JOUER, donc des visuels de cartes sous droits d'auteur.
# Elles sont reconstructibles a la commande et n'ont rien a faire dans un depot
# public. Trouvees non ignorees le 21-08 : 4,1 Mo de PNG a un `git add -A` de la
# publication.
web/webapp/verif/outputs/
